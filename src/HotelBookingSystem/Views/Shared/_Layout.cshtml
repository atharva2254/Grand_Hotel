<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - Grand Stay Hotel</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="d-flex flex-column min-vh-100">
<nav class="navbar navbar-expand-md navbar-dark bg-brand">
  <div class="container">
    <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">Grand Stay Hotel</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Find a room</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Booking" asp-action="Lookup">My booking</a></li>
        @if (User.IsInRole("Staff") || User.IsInRole("Admin"))
        {
            <li class="nav-item"><a class="nav-link" asp-controller="StaffBookings" asp-action="Index">Bookings</a></li>
        }
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item"><a class="nav-link" asp-controller="Rooms" asp-action="Index">Manage rooms</a></li>
        }
      </ul>
      <div class="d-flex align-items-center gap-2">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <span class="text-white-50 small">@User.Identity.Name</span>
            <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm">Logout</button></form>
        }
        else
        {
            <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Staff login</a>
        }
      </div>
    </div>
  </div>
</nav>
<main class="container py-4 flex-grow-1">
  @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
  @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
  @RenderBody()
</main>
<footer class="text-center text-muted small py-3 border-top">&copy; @DateTime.Now.Year Grand Stay Hotel</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
