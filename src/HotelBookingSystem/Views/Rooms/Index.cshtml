@model List<Room>
@{ ViewData["Title"] = "Manage rooms"; }
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h1 class="h3 mb-0">Manage rooms</h1>
  <a class="btn btn-brand" asp-action="Create">Add room</a>
</div>
<div class="table-responsive">
<table class="table align-middle mb-0">
  <thead><tr><th>Room</th><th>Type</th><th>Capacity</th><th>Price / night</th><th>Active</th><th></th></tr></thead>
  <tbody>
  @foreach (var r in Model)
  {
    <tr>
      <td>@r.RoomNumber</td><td>@r.RoomType</td><td>@r.Capacity</td><td>₹@r.PricePerNight.ToString("N0")</td>
      <td>@(r.IsActive ? "Yes" : "No")</td>
      <td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@r.Id">Edit</a>
        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@r.Id">Delete</a></td>
    </tr>
  }
  </tbody>
</table>
</div>
