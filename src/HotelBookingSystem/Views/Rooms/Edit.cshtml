@model Room
@{ ViewData["Title"] = "Edit room"; }
<div class="mx-auto" style="max-width:720px">
  <h1 class="h3 mb-3">Edit room</h1>
  <form asp-action="Edit" method="post">
    <partial name="_RoomForm" model="Model" />
    <div class="mt-3 d-flex gap-2"><button class="btn btn-brand">Save</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div>
  </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
