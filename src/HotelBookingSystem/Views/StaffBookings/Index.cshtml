@model List<Booking>
@{ ViewData["Title"] = "Bookings"; var status = ViewBag.Status as BookingStatus?; }
<h1 class="h3 mb-3">Bookings</h1>
<form method="get" class="row g-2 mb-3">
  <div class="col-12 col-md-5"><input class="form-control" name="q" value="@ViewBag.Q" placeholder="Search reference, name or email" aria-label="Search" /></div>
  <div class="col-8 col-md-4">
    <select class="form-select" name="status" aria-label="Status">
      <option value="">All statuses</option>
      @foreach (var s in Enum.GetValues<BookingStatus>())
      { <option value="@s" selected="@(status == s)">@s</option> }
    </select>
  </div>
  <div class="col-4 col-md-3"><button class="btn btn-brand w-100">Filter</button></div>
</form>
<div class="table-responsive">
<table class="table table-hover align-middle mb-0">
  <thead><tr><th>Ref</th><th>Guest</th><th>Room</th><th>Dates</th><th>Guests</th><th>Total</th><th>Status</th><th>Actions</th></tr></thead>
  <tbody>
  @foreach (var b in Model)
  {
    <tr>
      <td>@b.Reference</td>
      <td>@b.GuestName<br /><small class="text-muted">@b.GuestEmail · @b.GuestPhone</small></td>
      <td>@b.Room!.RoomType #@b.Room.RoomNumber</td>
      <td>@b.CheckIn.ToString("dd MMM") → @b.CheckOut.ToString("dd MMM yyyy")</td>
      <td>@b.Guests</td>
      <td>₹@b.TotalPrice.ToString("N0")</td>
      <td><span class="badge @(b.Status == BookingStatus.Cancelled ? "bg-danger" : b.Status == BookingStatus.Confirmed ? "bg-success" : "bg-secondary")">@b.Status</span></td>
      <td class="text-nowrap">
        @if (b.Status == BookingStatus.Confirmed)
        {
          <form asp-action="SetStatus" method="post" class="d-inline"><input type="hidden" name="id" value="@b.Id" /><input type="hidden" name="status" value="CheckedIn" /><button class="btn btn-sm btn-outline-primary">Check in</button></form>
          <form asp-action="SetStatus" method="post" class="d-inline" onsubmit="return confirm('Cancel this booking?');"><input type="hidden" name="id" value="@b.Id" /><input type="hidden" name="status" value="Cancelled" /><button class="btn btn-sm btn-outline-danger">Cancel</button></form>
        }
        else if (b.Status == BookingStatus.CheckedIn)
        {
          <form asp-action="SetStatus" method="post" class="d-inline"><input type="hidden" name="id" value="@b.Id" /><input type="hidden" name="status" value="CheckedOut" /><button class="btn btn-sm btn-outline-secondary">Check out</button></form>
        }
      </td>
    </tr>
  }
  @if (!Model.Any()) { <tr><td colspan="8" class="text-center text-muted py-4">No bookings found.</td></tr> }
  </tbody>
</table>
</div>
